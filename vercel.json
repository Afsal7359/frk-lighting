{
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 0 */2 * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "frklighting.com"
        }
      ],
      "destination": "https://www.frklighting.com/$1",
      "permanent": true
    }
  ]
}
